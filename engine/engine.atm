;; The engine of the port, over the environment ia-atmos/env-sdl
;; (`env/sdl.atm`, see `run.sh`) and `engine/flare.h`: the functions of C
;; as a table `fl`.
;;
;; The program runs inside the loop of the environment, which emits, once
;; per logic frame, the input of the frame, then `:frame [n, us]` (n from
;; 1), then `:draw`. The window is 1280x720, and the game draws in a
;; render of 1706x960, a surface of ARGB8888 (the software path).

include "../env/sdl.atm"

```:prelude
#include "engine/flare.h"
```

sdl.window [title="Flare", width=1280, height=720, logical=[1706, 960], software=true]
`fl_start();`

;; the frames done, and the input of the original (InputState); the mouse
;; is in the render, scaled by SDL as in the original (its logical size)
spawn {
    loop e on :frame {
        val n = e.n
        `FL_FRAME = (unsigned long)(fl_int($n) - 1);`
    }
}
spawn {
    loop on :draw {
        `FL_FRAME = (unsigned long)SDL_FRAME;`
    }
}
spawn {
    loop e on :key.dn {
        val c = e.code
        `fl_input_key(SDL_GetScancodeFromName(fl_cstr($c)), 1);`
    }
}
spawn {
    loop e on :key.up {
        val c = e.code
        `fl_input_key(SDL_GetScancodeFromName(fl_cstr($c)), 0);`
    }
}
spawn {
    loop e on :mouse.motion {
        val x, y = e.x, e.y
        `FL_MOUSE_X = fl_int($x); FL_MOUSE_Y = fl_int($y);`
    }
}
;; a press or a release of a button: the left one is MAIN1, the right one
;; MAIN2 (the bindings of SDLInputState)
func fl_mouse_button (e, down) {
    val x, y = e.x, e.y
    val b = match e.button {
        :left  => 1
        :right => 3
        else   => 0
    }
    `fl_input_mouse(fl_int($x), fl_int($y), fl_int($b), fl_int($down));`
}
spawn {
    loop e on :mouse.button.dn {
        fl_mouse_button(e, 1)
    }
}
spawn {
    loop e on :mouse.button.up {
        fl_mouse_button(e, 0)
    }
}

;; the images and the sounds of the environment, kept to the end, by the
;; indexes of `fl.img` and `fl.snd`
pin fl_imgs = []
pin fl_snds = []
pin fl_snds_by = []     ;; path -> index, loaded once

;; the actions of the input, as `Input::` of the original
pin Input = [
    CANCEL = 0, ACCEPT = 1, UP = 2, DOWN = 3, LEFT = 4, RIGHT = 5,
    BAR_1 = 6, BAR_2 = 7, BAR_3 = 8, BAR_4 = 9, BAR_5 = 10, BAR_6 = 11, BAR_7 = 12,
    BAR_8 = 13, BAR_9 = 14, BAR_0 = 15,
    CHARACTER = 16, INVENTORY = 17, POWERS = 18, LOG = 19, MAIN1 = 20, MAIN2 = 21,
    AIM_UP = 32, AIM_DOWN = 33, AIM_LEFT = 34, AIM_RIGHT = 35,
    CTRL = 40, SHIFT = 41, ALT = 42,
]

;; the movement and collide types of MapCollision
pin MOVE = [NORMAL = 0, FLYING = 1, INTANGIBLE = 2]
pin COLLIDE = [NONE = 0, ALL = 1, HERO = 2, HAZARD = 3]

pin fl = [
    ;; the size of the render
    W = `:number FL_W`,
    H = `:number FL_H`,

    ;; the logic frames done, and the frames per second of the original
    frame = func () {
        `:number FL_FRAME`
    },
    FPS = 60,

    ;; the generator of the patched original: from 0 to 2^31-1
    rand = func () {
        `:number fl_rand()`
    },

    ;; the names of the files of a directory with an extension, in the
    ;; order of readdir, or nil
    dir = func (path, ext) {
        `:value fl_dir(fl_cstr($path), fl_cstr($ext))`
    },

    ;; the calls to fl.rand since the last time
    rand_calls = func () {
        val n = `:number FL_RND_CALLS`
        `FL_RND_CALLS = 0;`
        n
    },

    ;; a line of the trace, after the logic frame
    trace = func (s) {
        `fl_trace(fl_cstr($s));`
    },
    tracing = func () {
        `:boolean (FL_TRACE != NULL)`
    },

    ;; images: an index, or -1
    img = func (path, raw) {
        val r = if raw => 1 => 0
        val i = `:number fl_img_find(fl_cstr($path), fl_int($r))`
        if i != -2 {
            return i
        }
        val v = sdl.image(path, raw)
        set fl_imgs@+ = v
        `:number fl_img_add($v, fl_cstr($path), fl_int($r))`
    },
    size = func (i) {
        val w = `:number ({ FlImg* p = fl_img(fl_int($i)); p ? p->w : 0; })`
        val h = `:number ({ FlImg* p = fl_img(fl_int($i)); p ? p->h : 0; })`
        return w, h
    },
    ;; the size of the render (the view of the original)
    view = func () {
        val w = `:number FL_W`
        val h = `:number FL_H`
        return w, h
    },
    ;; fl.draw(img, x, y): the whole image
    draw = func (i, x, y) {
        `fl_img_draw(fl_int($i), 0,0,0,0, fl_int($x),fl_int($y), 255, 0xFFFFFF, 0);`
    },
    ;; fl.part(img, sx,sy,sw,sh, x,y [,alpha [,color [,blend]]])
    part = func (i, sx, sy, sw, sh, x, y, a, c, b) {
        val alpha = if a == nil => 255 => a
        val color = if c == nil => 0xFFFFFF => c
        val blend = if b == nil => 0 => b
        `fl_img_draw(fl_int($i), fl_int($sx),fl_int($sy),fl_int($sw),fl_int($sh), fl_int($x),fl_int($y), fl_int($alpha), fl_int($color), fl_int($blend));`
    },
    ;; fl.fill(0xRRGGBBAA, x,y,w,h)
    fill = func (c, x, y, w, h) {
        `fl_fill((int64_t)a_dbl($c), fl_int($x),fl_int($y),fl_int($w),fl_int($h));`
    },

    ;; fonts: an index, or -1; style: 1 bold, 2 italic, 4 underline
    font = func (path, size, style) {
        val st = style || 0
        `:number fl_font_load(fl_cstr($path), fl_int($size), fl_int($st))`
    },
    ;; fl.text(font, s, x, y [,color [,justify [,blend]]]): justify 0 left,
    ;; 1 right, 2 center
    text = func (f, s, x, y, color, justify, blend) {
        val c = if color == nil => 0xFFFFFF => color
        val j = justify || 0
        val b = if blend == false => 0 => 1
        `fl_font_draw(fl_int($f), fl_cstr($s), fl_int($x), fl_int($y), fl_int($j), fl_int($c), fl_int($b));`
    },
    ;; fl.label(font, s, x, y, color, sx, sy, blend, alpha): a label with its
    ;; shadow at sx,sy, its top left at x,y (see fl_label)
    label = func (f, s, x, y, color, sx, sy, blend, alpha) {
        val b = if blend == false => 0 => 1
        val a = if alpha == nil => 255 => alpha
        `fl_label(fl_int($f), fl_cstr($s), fl_int($x), fl_int($y), fl_int($color), fl_int($sx), fl_int($sy), fl_int($b), fl_int($a));`
    },
    ;; fl.label_wrap(font, s, x, y, color, sx, sy, blend, width): a label
    ;; wrapped to a width (see fl_label_wrap); fl.wrap_size: its size
    label_wrap = func (f, s, x, y, color, sx, sy, blend, width) {
        val b = if blend == false => 0 => 1
        `fl_label_wrap(fl_int($f), fl_cstr($s), fl_int($x), fl_int($y), fl_int($color), fl_int($sx), fl_int($sy), fl_int($b), fl_int($width));`
    },
    wrap_size = func (f, s, width) {
        `fl_wrap(fl_int($f), fl_cstr($s), fl_int($width));`
        return `:number FL_WRAP_W`, `:number FL_WRAP_H`
    },
    line_height = func (f) {
        `:number ((fl_int($f) >= 0 && fl_int($f) < FL_FONTS_N) ? TTF_FontLineSkip(FL_FONTS[fl_int($f)]) : 1)`
    },
    ;; the height of a label: of the text, or of the line if more
    label_height = func (f, s) {
        `:number ({ int w=0, h=0; if (fl_int($f) >= 0 && fl_int($f) < FL_FONTS_N) { TTF_SizeUTF8(FL_FONTS[fl_int($f)], fl_cstr($s), &w, &h); int l = TTF_FontLineSkip(FL_FONTS[fl_int($f)]); if (l > h) h = l; } h; })`
    },
    text_width = func (f, s) {
        `:number fl_font_width(fl_int($f), fl_cstr($s))`
    },
    text_height = func (f) {
        `:number fl_font_height(fl_int($f))`
    },

    ;; sounds: an index, or -1; with no audio, a sound that plays nothing
    snd = func (path) {
        if fl_snds_by@path == nil {
            val v = sdl.sound(path)
            set fl_snds_by@path = if v == nil {
                -1
            } else {
                set fl_snds@+ = v
                #fl_snds - 1
            }
        }
        fl_snds_by@path
    },
    ;; a volume from 0 to 128
    play = func (i, vol) {
        val v = if vol == nil => 128 => vol
        if fl_snds@i {
            sdl.play(fl_snds@i, v / 128)
        }
    },
    music = func (path) {
        sdl.music(path)
    },
    music_stop = func () {
        sdl.music_stop()
    },

    ;; the minimap: see `engine/minimap.h`
    map_size = func () {
        return `:number FL_MAP_W`, `:number FL_MAP_H`
    },
    mm_prerender = func (zoom, w, h, wall, obst) {
        `fl_mm_prerender(fl_int($zoom), fl_int($w), fl_int($h), (int64_t)a_dbl($wall), (int64_t)a_dbl($obst));`
    },
    mm_clear = func () {
        `fl_mm_clear();`
    },
    mm_entity = func (x, y, ox, oy, c) {
        `fl_mm_entity(fl_int($x), fl_int($y), fl_int($ox), fl_int($oy), (int64_t)a_dbl($c));`
    },
    mm_draw = func (cx, cy, w, h, ax, ay) {
        `fl_mm_draw(fl_int($cx), fl_int($cy), fl_int($w), fl_int($h), fl_int($ax), fl_int($ay));`
    },

    ;; the map: see `engine/map.h`
    tset_reset = func () {
        `fl_tset_reset();`
    },
    tset_tile = func (i, img, x, y, w, h, ox, oy) {
        `fl_tset_tile(fl_int($i), fl_int($img), fl_int($x), fl_int($y), fl_int($w), fl_int($h), fl_int($ox), fl_int($oy));`
    },
    tset_anim = func (i, x, y, dur) {
        `fl_tset_anim(fl_int($i), fl_int($x), fl_int($y), fl_int($dur));`
    },
    tset_done = func () {
        `fl_tset_done();`
    },
    tset_logic = func () {
        `fl_tset_logic();`
    },
    map_new = func (w, h) {
        `fl_map_new(fl_int($w), fl_int($h));`
    },
    map_layer = func (name) {
        `:number fl_map_layer(fl_cstr($name))`
    },
    map_row = func (l, y, s) {
        `:boolean fl_map_row(fl_int($l), fl_int($y), fl_cstr($s))`
    },
    map_done = func (bg) {
        `FL_BG = (int64_t)a_dbl($bg);`
        `fl_map_done();`
    },
    hotspot_hit = func (x, y, mx, my) {
        `:boolean fl_hotspot_hit(fl_int($x), fl_int($y), fl_int($mx), fl_int($my))`
    },
    map_mod = func (layer, x, y, tile) {
        `fl_map_mod(fl_cstr($layer), fl_int($x), fl_int($y), fl_int($tile));`
    },
    map_render = func () {
        `fl_map_render();`
    },
    ;; the camera: positions are 32-bit floats
    cam_warp = func (x, y) {
        `fl_cam_warp((float)a_dbl($x), (float)a_dbl($y));`
    },
    cam_target = func (x, y) {
        `fl_cam_target((float)a_dbl($x), (float)a_dbl($y));`
    },
    ;; the camera shakes for some frames (shake_timer of Camera)
    cam_shake = func (n) {
        `FL_SHAKE_TIMER = fl_int($n);`
    },
    cam_logic = func () {
        `fl_cam_logic();`
    },
    ;; the size of a tile on the screen (the tileset's tile_size)
    tile = func () {
        return `:number FL_TILE_W`, `:number FL_TILE_H`
    },
    cam = func () {
        return `:number.float (double)FL_CAM.x`, `:number.float (double)FL_CAM.y`
    },
    ;; objects to draw in this frame: fl.ren(dead, img, sx,sy,sw,sh, ox,oy, mx,my, prio, hero, alpha, color, blend)
    ren_clear = func () {
        `fl_ren_clear();`
    },
    ren = func (dead, img, sx, sy, sw, sh, ox, oy, mx, my, prio, hero, alpha, color, blend) {
        val d = if dead => 1 => 0
        val h = if hero => 1 => 0
        val a = alpha || 255
        val c = color || 0xFFFFFF
        val b = blend || 0
        `fl_ren_push(fl_int($d), fl_int($img), fl_int($sx), fl_int($sy), fl_int($sw), fl_int($sh), fl_int($ox), fl_int($oy), (float)a_dbl($mx), (float)a_dbl($my), fl_int($prio), fl_int($h), fl_int($a), fl_int($c), fl_int($b));`
    },

    ;; input: the actions of `Input` (pressing, lock), and the mouse
    pressing = func (k) {
        `:boolean FL_PRESSING[fl_int($k)]`
    },
    locked = func (k) {
        `:boolean FL_LOCK[fl_int($k)]`
    },
    lock = func (k, v) {
        val b = if v => 1 => 0
        `FL_LOCK[fl_int($k)] = fl_int($b);`
    },
    ;; pressing and not locked
    pressed = func (k) {
        `:boolean (FL_PRESSING[fl_int($k)] && !FL_LOCK[fl_int($k)])`
    },
    mouse = func () {
        return `:number FL_MOUSE_X`, `:number FL_MOUSE_Y`
    },

    ;; collision: see `engine/collision.h`
    col_block = func (x, y, ally) {
        val a = if ally => 1 => 0
        `fl_col_block((float)a_dbl($x), (float)a_dbl($y), fl_int($a));`
    },
    col_unblock = func (x, y) {
        `fl_col_unblock((float)a_dbl($x), (float)a_dbl($y));`
    },
    ;; MapCollision::isOutsideMap, of a position
    col_outside = func (x, y) {
        `:boolean ((float)a_dbl($x) < 0 || (float)a_dbl($y) < 0 || (float)a_dbl($x) >= (float)FL_MAP_W || (float)a_dbl($y) >= (float)FL_MAP_H)`
    },
    col_valid = func (x, y, mt, ct) {
        `:boolean fl_col_valid((float)a_dbl($x), (float)a_dbl($y), fl_int($mt), fl_int($ct))`
    },
    col_sight = func (x1, y1, x2, y2) {
        `:boolean fl_col_sight((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2))`
    },
    ;; fl.move(x, y, dir, speed, effect_speed, mt, hero): ok, x, y
    move = func (x, y, dir, speed, eff, mt, hero) {
        val h = if hero => 1 => 0
        val ok = `:boolean fl_entity_move((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($speed), (float)a_dbl($eff), fl_int($mt), fl_int($h))`
        return ok, `:number.float (double)FL_MOVE_X`, `:number.float (double)FL_MOVE_Y`
    },
    ;; map to screen, at a camera (as Utils::mapToScreen)
    map2scr = func (x, y, cx, cy) {
        val sx = `:number fl_map2scr((float)a_dbl($x), (float)a_dbl($y), (float)a_dbl($cx), (float)a_dbl($cy)).x`
        val sy = `:number fl_map2scr((float)a_dbl($x), (float)a_dbl($y), (float)a_dbl($cx), (float)a_dbl($cy)).y`
        return sx, sy
    },
    ;; screen to map, at the camera (as Utils::screenToMap)
    scr2map = func (x, y) {
        val p = `:number.float (double)fl_scr2map(fl_int($x), fl_int($y), FL_CAM.x, FL_CAM.y).x`
        val q = `:number.float (double)fl_scr2map(fl_int($x), fl_int($y), FL_CAM.x, FL_CAM.y).y`
        return p, q
    },

    ;; geometry with 32-bit floats: see `engine/geom.h`
    direction = func (x0, y0, x1, y1) {
        `:number fl_direction((float)a_dbl($x0), (float)a_dbl($y0), (float)a_dbl($x1), (float)a_dbl($y1))`
    },
    dist = func (x1, y1, x2, y2) {
        `:number.float (double)fl_distf((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2))`
    },
    vector = func (x, y, dir, d) {
        val px = `:number.float (double)fl_vector((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($d)).x`
        val py = `:number.float (double)fl_vector((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($d)).y`
        return px, py
    },
    ;; speed * SPEED_MULTIPLIER[dir] * effect_speed / 100, in floats
    real_speed = func (speed, dir, eff) {
        `:number.float (double)((float)a_dbl($speed) * FL_SPEED_MULT[fl_int($dir)] * (float)a_dbl($eff) / 100)`
    },
    clamp_dist = func (rmin, rmax, sx, sy, tx, ty) {
        val x = `:number.float (double)fl_clamp_dist((float)a_dbl($rmin), (float)a_dbl($rmax), (float)a_dbl($sx), (float)a_dbl($sy), (float)a_dbl($tx), (float)a_dbl($ty)).x`
        val y = `:number.float (double)fl_clamp_dist((float)a_dbl($rmin), (float)a_dbl($rmax), (float)a_dbl($sx), (float)a_dbl($sy), (float)a_dbl($tx), (float)a_dbl($ty)).y`
        return x, y
    },
    ;; a free tile around the tile of (x,y), with a draw if any (getRandomNeighbor)
    random_neighbor = func (x, y, range, mt, ct) {
        `{ FlPt p = fl_random_neighbor((int)a_dbl($x), (int)a_dbl($y), fl_int($range), fl_int($mt), fl_int($ct)); FL_MOVE_X = p.x; FL_MOVE_Y = p.y; }`
        return `:number.float (double)FL_MOVE_X`, `:number.float (double)FL_MOVE_Y`
    },
    theta = func (x1, y1, x2, y2) {
        `:number.float (double)fl_theta((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2))`
    },
    ;; the speed of a missile at an angle (Hazard::setAngle): sx, sy
    missile_speed = func (base, angle) {
        val sx = `:number.float (double)fl_missile_speed((float)a_dbl($base), (float)a_dbl($angle)).x`
        val sy = `:number.float (double)fl_missile_speed((float)a_dbl($base), (float)a_dbl($angle)).y`
        return sx, sy
    },
    ;; the step of a repeater (PowerManager::repeater): its speed per
    ;; second over the logic rate, in the angle from origin to target
    repeater_speed = func (speed, theta) {
        val sx = `:number.float (double)(((float)a_dbl($speed) * 60.f / 60.f) * cosf((float)a_dbl($theta)))`
        val sy = `:number.float (double)(((float)a_dbl($speed) * 60.f / 60.f) * sinf((float)a_dbl($theta)))`
        return sx, sy
    },
    rotate = func (dir, v) {
        `:number fl_rotate(fl_int($dir), fl_int($v))`
    },
    face_next = func (dir, x, y, mx, my) {
        `:number fl_face_next(fl_int($dir), (float)a_dbl($x), (float)a_dbl($y), (float)a_dbl($mx), (float)a_dbl($my))`
    },

    ;; the path from one point to another (MapCollision::computePath): its
    ;; points from the end to the start, or an empty vector
    path = func (sx, sy, ex, ey, mt) {
        `fl_path((float)a_dbl($sx), (float)a_dbl($sy), (float)a_dbl($ex), (float)a_dbl($ey), fl_int($mt), 0);`
        val n = `:number FL_PATH_N`
        val ret = []
        loop i in n {
            set ret@+ = [`:number.float (double)FL_PATH[(int)a_dbl($i)].x`, `:number.float (double)FL_PATH[(int)a_dbl($i)].y`]
        }
        ret
    },
    line_move = func (x1, y1, x2, y2, mt) {
        `:boolean fl_col_line_move((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2), fl_int($mt))`
    },

    ;; f32(x): x rounded to 32 bits, as a `float` of the original
    f32 = func (x) {
        `:number.float (double)(float)a_dbl($x)`
    },
]

