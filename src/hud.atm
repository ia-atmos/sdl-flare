;; The HUD of GameStatePlay, drawn by MenuManager::render over the map.
;;
;;      hud.init()      its images and the positions of menus/*.txt
;;      hud.logic(h)    the logic of the menus, before the hero's
;;      hud.draw(h)     a frame of the menus over the map, for the hero `h`
;;
;; Done: the bars of life, mana, and experience (MenuStatBar), the action
;; bar (MenuActionBar), the enemy under the mouse (MenuEnemy), the title
;; of the region (MenuRegionTitle), the minimap (MenuMiniMap, its zoom of
;; 1x: the click that turns it to 2x is not ported), the effects of the
;; hero (MenuActiveEffects; no effect of the slice groups its stacks), the
;; log of messages (MenuHUDLog; its overlay over open menus is not ported). Not drawn: tooltips and the
;; labels of hotkeys (hidden by engine/widget_settings.txt).

pin hud = [
    img = [],           ;; the images by name
    icon = 64,          ;; resolutions.txt: icon_size
    bar = nil,          ;; the action bar: [x, y, w, h, slots]
    state = [],         ;; the slots of the action bar, by hud.logic
    stats = [],         ;; the bars: hp, mp, xp (MenuStatBar), by order
    emenu = nil,        ;; MenuEnemy: its menu, and its timer
    enemy = nil,        ;; the enemy shown, set :out (nil when it ends)
    region = nil,       ;; MenuRegionTitle: its label, title, alpha, timers
    map_title = "",     ;; the title of the map (MapRenderer::title)
    mini = nil,         ;; MenuMiniMap: its menu, colors, zoom, button
    map_change = false, ;; a new map: the minimap is drawn again
    ens = nil,          ;; the enemies of the map, set :out by MapRun
    npcs = nil,         ;; the NPCs of the map, set :out by MapRun
    events = nil,       ;; the events of the map, set :out by MapRun
    effects = [],       ;; MenuActiveEffects: [icon, x, y, overlay y], by hud.logic
    fx_pos = [8, 80],   ;; its window
    log = [],           ;; MenuHUDLog: [text, age] of each message
    log_area = nil,     ;; its window [x, y, w, h], and its spacing
]

;; Utils::alignToScreenEdge of a rect of a menu
func hud.align (al, x, y, w, h) {
    val vw, vh = fl.view()
    val hw, hh = vw // 2, vh // 2
    match al {
        "topleft"     => [x, y]
        "top"         => [hw - (w // 2) + x, y]
        "topright"    => [vw - w + x, y]
        "left"        => [x, hh - (h // 2) + y]
        "center"      => [hw - (w // 2) + x, hh - (h // 2) + y]
        "right"       => [vw - w + x, hh - (h // 2) + y]
        "bottomleft"  => [x, vh - h + y]
        "bottom"      => [hw - (w // 2) + x, vh - h + y]
        "bottomright" => [vw - w + x, vh - h + y]
        else          => [x, y]
    }
}

;; the keys of a menu file: pos and align, and the others as given
func hud.menu (path) {
    val m = [x = 0, y = 0, w = 0, h = 0, align = "topleft", keys = []]
    loop _, s in ini.load(path) || [] {
        loop _, kv in s.keys {
            val k, v = kv@0, kv@1
            match k {
                "pos" => {
                    pin l = parse.list(v)
                    set m.x, m.y = parse.int(l@0), parse.int(l@1)
                    set m.w, m.h = parse.int(l@2), parse.int(l@3)
                }
                "align" => { set m.align = v }
                else => { set m.keys@+ = kv }
            }
        }
    }
    val p = hud.align(m.align, m.x, m.y, m.w, m.h)
    set m.x, m.y = p@0, p@1
    m
}

func hud.image (name) {
    if hud.img@name == nil {
        set hud.img@name = fl.img(ini.locate(name) || name)
    }
    hud.img@name
}

func hud.init () {
    set hud.icon = 64
    loop _, s in ini.load("engine/resolutions.txt") || [] {
        loop _, kv in s.keys {
            if kv@0 == "icon_size" {
                set hud.icon = parse.int(kv@1)
            }
        }
    }
    ;; MenuActionBar: slot=index,x,y for 1 to 10, slot_M1 and slot_M2 are
    ;; 11 and 12 (indexes 10 and 11 of the actionbar of the class)
    val m = hud.menu("menus/actionbar.txt")
    val slots = []
    loop _, kv in m.keys {
        val k = kv@0
        if (k == "slot") || (k == "slot_M1") || (k == "slot_M2") {
            pin l = parse.list(kv@1)
            val i = match k {
                "slot" => parse.int(l@0) - 1
                "slot_M1" => 10
                else => 11
            }
            val o = if k == "slot" => 1 => 0
            set slots@i = [m.x + parse.int(l@(o)), m.y + parse.int(l@(o + 1))]
        }
    }
    set hud.bar = [x = m.x, y = m.y, w = m.w, h = m.h, slots = slots]
    set hud.stats = [hud.statbar("hp"), hud.statbar("mp"), hud.statbar("xp")]
    ;; MenuEnemy: menus/enemy.txt, and its timeout (10 s by default)
    val em = hud.menu("menus/enemy.txt")
    val e = [x = em.x, y = em.y, pos = [0, 0, em.w, em.h], fill = nil, off = [0, 0],
             text = nil, gfx = nil, bg = nil, timeout = timer(60 * 10)]
    loop _, kv in em.keys {
        val k, v = kv@0, kv@1
        val l = parse.list(v)
        match k {
            "bar_pos" => { set e.pos = [parse.int(l@0), parse.int(l@1), parse.int(l@2), parse.int(l@3)] }
            "bar_fill_size" => { set e.fill = [parse.int(l@0), parse.int(l@1)] }
            "bar_fill_offset" => { set e.off = [parse.int(l@0), parse.int(l@1)] }
            "text_pos" => { set e.text = hud.label_info(l) }
            "bar_gfx" => { set e.gfx = v }
            "background" => { set e.bg = v }
            "timeout" => { set e.timeout = timer(parse.duration(v)) }
        }
    }
    set e.fill = e.fill || [e.pos@2, e.pos@3]
    set hud.emenu = e
    ;; MenuRegionTitle: menus/region_title.txt
    val rm = hud.menu("menus/region_title.txt")
    val r = [x = rm.x, y = rm.y, label = hud.label_info(["0", "0", "center", "top", "font_region_title"]),
             title = "", alpha = 0, visible = false,
             hold = timer(60 * 3), fin = timer(60), fout = timer(60)]
    loop _, kv in rm.keys {
        val k, v = kv@0, kv@1
        match k {
            "label" => { set r.label = hud.label_info(parse.list(v)) }
            "hold_duration" => { set r.hold = timer(parse.duration(v)) }
            "fade_in_duration" => { set r.fin = timer(parse.duration(v)) }
            "fade_out_duration" => { set r.fout = timer(parse.duration(v)) }
        }
    }
    set hud.region = r
    ;; MenuMiniMap: menus/minimap.txt
    val mm = hud.menu("menus/minimap.txt")
    val mi = [x = mm.x, y = mm.y, w = mm.w, h = mm.h, bg = nil, pos = [0, 0, 0, 0],
              label = hud.label_info(["0", "0", "left", "top"]), zoom = 1, button = nil,
              wall = 0x808080, obst = 0x404040, hero = 0xFFFFFF, enemy = 0xFF0000,
              ally = 0xFFFF00, npc = 0x00FF00, teleport = 0x00BFFF]
    loop _, kv in mm.keys {
        val k, v = kv@0, kv@1
        val l = parse.list(v)
        match k {
            "background" => { set mi.bg = v }
            "map_pos" => { set mi.pos = [parse.int(l@0), parse.int(l@1), parse.int(l@2), parse.int(l@3)] }
            "text_pos" => { set mi.label = hud.label_info(l) }
            "default_zoom_level" => { set mi.zoom = parse.int(v) }
            "button_config" => { set mi.button = [mi.x + parse.int(l@0), mi.y + parse.int(l@1)] }
            "color_wall" => { set mi.wall = hud.rgb(l) }
            "color_obst" => { set mi.obst = hud.rgb(l) }
            "color_hero" => { set mi.hero = hud.rgb(l) }
            "color_enemy" => { set mi.enemy = hud.rgb(l) }
            "color_ally" => { set mi.ally = hud.rgb(l) }
            "color_npc" => { set mi.npc = hud.rgb(l) }
            "color_teleport" => { set mi.teleport = hud.rgb(l) }
        }
    }
    ;; visible_radius
    set mi.radius = fl.f32(fl.f32(math.max(mi.pos@2, mi.pos@3)) * fl.f32(0.7071))
    set hud.mini = mi
    val fm = hud.menu("menus/activeeffects.txt")
    set hud.fx_pos = [fm.x, fm.y]
    ;; MenuHUDLog: menus/hudlog.txt; the spacing of paragraphs is half a
    ;; line of font_regular
    val lm = hud.menu("menus/hudlog.txt")
    set hud.log_area = [x = lm.x, y = lm.y, w = lm.w, h = lm.h,
                        ps = fl.line_height(font.styles@("font_regular").img) // 2]
}

;; MenuHUDLog::add: a new message (or the same one again, unless unique,
;; for longer), on the screen 5 s and 0.1 s per byte, no less than the one
;; before
func hud.log_add (s, unique) {
    val n = #hud.log
    val age = (60 * 5) + (#s * 6)
    if (n == 0) || (hud.log@(n - 1)@0 != s) || unique {
        set hud.log@+ = [s, age]
    } else {
        set hud.log@(n - 1)@1 = age
    }
    val m = #hud.log
    if (m > 1) && (hud.log@(m - 1)@1 < hud.log@(m - 2)@1) {
        set hud.log@(m - 1)@1 = hud.log@(m - 2)@1
    }
}

;; GameStatePlay::checkLog: cleared at a respawn, then the messages of the
;; hero
func hud.log_check (h) {
    if h.respawn {
        set hud.log = []
    }
    loop _, m in h.log_msg {
        hud.log_add(m@0, m@1)
    }
    set h.log_msg = []
}

;; MenuHUDLog::logic: each message ages; one aged out is removed (and the
;; one after it waits for the next frame, as the loop of the original)
func hud.log_logic () {
    var i = 0
    loop {
        while i < #hud.log
        val m = hud.log@i
        if m@1 > 0 {
            set m@1 = m@1 - 1
        } else {
            vector.remove(hud.log, i)
        }
        set i = i + 1
    }
}

;; MenuHUDLog::render: from the bottom of its window, the newest first,
;; while they fit
func hud.draw_log () {
    val a = hud.log_area
    val f = font.styles@("font_regular")
    val x = a.x + a.ps
    var y = a.y + a.h
    var i = #hud.log
    loop {
        while i > 0
        set i = i - 1
        val m = hud.log@i
        until !((m@1 > 0) && (y > a.y))
        val _, mh = fl.wrap_size(f.img, m@0, a.w - (a.ps * 2))
        set y = y - (mh + a.ps)
        fl.label_wrap(f.img, m@0, x, y, font.color("menu_normal"), f.shadow@0, f.shadow@1, f.blend, a.w - (a.ps * 2))
    }
}

func hud.rgb (l) {
    (parse.int(l@0) << 16) | (parse.int(l@1) << 8) | parse.int(l@2)
}

;; Parse::popLabelInfo: x, y, justify, valign, style
func hud.label_info (l) {
    val j = l@2 || ""
    val v = l@3 || ""
    [x = parse.int(l@0), y = parse.int(l@1),
     justify = if j == "center" => font.CENTER => (if j == "right" => font.RIGHT => font.LEFT),
     valign = if v == "center" => font.CENTER => (if v == "bottom" => font.BOTTOM => font.TOP),
     style = if (l@4 || "") != "" => l@4 => "font_regular"]
}

;; GameStatePlay::checkEnemyFocus: the enemy shown, and its time again
func hud.enemy_focus (e) {
    if e && !e.suppress_hp {
        set :out hud.enemy = e
        timer_begin(hud.emenu.timeout)
    }
}

;; MenuStatBar: menus/<k>.txt
func hud.statbar (k) {
    val m = hud.menu("menus/" ++ k ++ ".txt")
    val b = [kind = k, x = m.x, y = m.y, pos = [0, 0, m.w, m.h], fill = nil,
             off = [0, 0], gfx = nil, bg = nil, cur = 0, max = 0]
    loop _, kv in m.keys {
        val k, v = kv@0, kv@1
        match k {
            "bar_pos" => {
                val l = parse.list(v)
                set b.pos = [parse.int(l@0), parse.int(l@1), parse.int(l@2), parse.int(l@3)]
            }
            "bar_fill_size" => {
                val l = parse.list(v)
                set b.fill = [parse.int(l@0), parse.int(l@1)]
            }
            "bar_fill_offset" => {
                val l = parse.list(v)
                set b.off = [parse.int(l@0), parse.int(l@1)]
            }
            "bar_gfx" => { set b.gfx = v }
            "bar_gfx_background" => { set b.bg = v }
        }
    }
    set b.fill = b.fill || [b.pos@2, b.pos@3]
    b
}

;; the icon `n` of images/icons/icons.png at (x,y)
func hud.draw_icon (n, x, y) {
    val ic = hud.image("images/icons/icons.png")
    val iw, _ = fl.size(ic)
    val cols = iw // hud.icon
    fl.part(ic, (n % cols) * hud.icon, (n // cols) * hud.icon, hud.icon, hud.icon, x, y)
}

;; MenuActionBar::logic, at the start of the logic of a frame (before the
;; hero's): per slot, nil (empty), or [icon, enabled, cooldown]
func hud.logic (h) {
    val st = []
    loop i in (0, 11) {
        val id = hero.actionbar@i || 0
        val pw = if id == 0 => nil => power.get(id)
        if pw {
            ;; StatBlock::canUsePower, as far as the slice needs it
            val can = (h.hp > 0) && (pw.requires_mp <= h.mp) && !h.stun
            val cast = h.casting@id
            val casting = cast && !timer_end(cast) && (cast.dur > 0)
            val cd = if can && casting => (cast.cur / cast.dur) => 1.0
            set st@i = [pw.icon, !casting && can, cd]
        }
    }
    set hud.state = st
    ;; MenuEnemy::logic: hidden after its time, or with its corpse gone
    timer_tick(hud.emenu.timeout)
    if timer_end(hud.emenu.timeout) {
        set hud.enemy = nil
    }
    val en = hud.enemy
    if en && en.corpse && timer_end(en.corpse_timer) {
        set hud.enemy = nil
    }
    hud.region_logic()
    hud.log_logic()
    ;; MenuActiveEffects::logic: an icon per effect that has one, in rows
    val vw, _ = fl.view()
    val per = math.max(1, (vw - hud.fx_pos@0) // hud.icon)
    val ics = []
    ;; the effects of the list of the original: those alive but the ones a
    ;; request removes, then the requests (EffectManager::addEffect adds at
    ;; once; the port at the next logic of the entity), with a full timer
    val gone = []
    loop _, t in h.fx_remove || [] {
        set gone@t = true
    }
    loop _, r in h.fx_add || [] {
        if !r.can_stack {
            set gone@(r.id) = true
        }
    }
    val list = []
    loop _, f in h.fx_icons || [] {
        if !gone@(f.type) && !gone@(f.id) {
            set list@+ = f
        }
    }
    loop _, r in h.fx_add || [] {
        set list@+ = [icon = r.icon, type = r.type, cur = r.dur, dur = r.dur,
                      shield = if r.type == "shield" => [m = r.m, max = r.m] => nil]
    }
    loop _, f in list {
        if f.icon != -1 {
            val n = #ics
            val x = hud.fx_pos@0 + ((n % per) * hud.icon)
            val y = hud.fx_pos@1 + ((n // per) * hud.icon)
            val oy = ifs {
                f.type == "shield" => math.floor(fl.f32(fl.f32(hud.icon * f.shield.m) / f.shield.max))
                f.type == "heal" => hud.icon
                f.dur > 0 => (hud.icon * f.cur) // f.dur
                else => hud.icon
            }
            set ics@+ = [icon = f.icon, x = x, y = y, oy = oy]
        }
    }
    set hud.effects = ics
    ;; MenuStatBar::update
    val hb, mb, xb = hud.stats@0, hud.stats@1, hud.stats@2
    set hb.cur, hb.max = h.hp, h.hp_max
    set mb.cur, mb.max = h.mp, h.mp_max
    val l0 = hero.level_xp(h.level)
    set xb.cur, xb.max = h.xp - l0, hero.level_xp(h.level + 1) - l0
}

;; MenuStatBar::render, horizontal: the background, then the fill
func hud.draw_stat (b) {
    val bx, by = b.pos@0 + b.x, b.pos@1 + b.y
    if b.bg {
        fl.part(hud.image(b.bg), 0, 0, b.pos@2, b.pos@3, bx, by)
    }
    val cur = math.min(b.cur, b.max)
    val len = if b.kind == "xp" {
        if b.max == 0 => 0 => ((cur * b.fill@0) // b.max)
    } else {
        if b.max == 0 => 0 => math.floor(fl.f32(fl.f32(cur * b.fill@0) / b.max))
    }
    val n = if (len == 0) && (cur > 0) => 1 => len
    if b.gfx && (n > 0) {
        fl.part(hud.image(b.gfx), 0, 0, n, b.fill@1, bx + b.off@0, by + b.off@1)
    }
}

;; MenuActionBar::render: the trim, an empty slot where no power is set,
;; the icon of the power, and the wipe of a slot disabled
func hud.draw_bar () {
    val b = hud.bar
    fl.part(hud.image("images/menus/actionbar_trim.png"), 0, 0, b.w, b.h, b.x, b.y)
    loop i in (0, 11) {
        val p = b.slots@i
        val s = hud.state@i
        if p {
            if !s {
                fl.part(hud.image("images/menus/slot_empty.png"), 0, 0, hud.icon, hud.icon, p@0, p@1)
            } else {
                hud.draw_icon(s@0, p@0, p@1)
                if !s@1 || (s@2 < 1) {
                    val ch = if s@2 > 0 => math.floor(hud.icon * s@2) => hud.icon
                    if ch > 0 {
                        fl.part(hud.image("images/menus/disabled.png"), 0, 0, hud.icon, ch, p@0, p@1)
                    }
                }
            }
        }
    }
}

;; MenuRegionTitle::logic: the fade in, the hold, the fade out
func hud.region_logic () {
    val r = hud.region
    if !r.visible {
        return nil
    }
    if timer_end(r.hold) && timer_end(r.fout) {
        set r.visible = false
    } else {
        if (r.hold.cur == r.hold.dur) && !timer_end(r.fin) {
            val t = fl.f32(fl.f32(r.fin.cur) / fl.f32(r.fin.dur))
            set r.alpha = math.floor(fl.f32(255 * fl.f32(1 - t)))
            timer_tick(r.fin)
        }
        if !timer_end(r.hold) && timer_end(r.fin) {
            set r.alpha = 255
            timer_tick(r.hold)
        }
        if timer_end(r.hold) && !timer_end(r.fout) {
            val t = fl.f32(fl.f32(r.fout.cur) / fl.f32(r.fout.dur))
            set r.alpha = math.floor(fl.f32(255 * t))
            timer_tick(r.fout)
        }
    }
}

;; MenuRegionTitle::setTitle, from GameStatePlay::render: a new title
;; shows again from its fade in
func hud.region_title (t) {
    val r = hud.region
    if t != r.title {
        set r.title = t
        set r.alpha = 0
        timer_begin(r.hold)
        timer_begin(r.fin)
        timer_begin(r.fout)
        set r.visible = true
    }
}

;; MenuRegionTitle::render: its label (its background has no size)
func hud.draw_region () {
    val r = hud.region
    if r.visible {
        val l = r.label
        font.label(l.style, r.title, r.x + l.x, r.y + l.y, l.justify, l.valign, font.color("menu_normal"), r.alpha)
    }
}

;; MenuMiniMap::render(hero_pos): the background, the title of the map,
;; the tiles and the entities around the hero, the compass, the button
func hud.draw_mini (h) {
    val m = hud.mini
    if hud.map_change {
        fl.mm_prerender(m.zoom, m.pos@2, m.pos@3, m.wall, m.obst)
        set hud.map_change = false
    }
    if m.bg {
        fl.part(hud.image(m.bg), 0, 0, m.w, m.h, m.x, m.y)
    }
    val l = m.label
    font.label(l.style, hud.map_title, m.x + l.x, m.y + l.y, l.justify, l.valign, font.color("menu_normal"))
    ;; renderMapSurface: the hero at a whole tile
    val z = m.zoom
    val hx, hy = math.floor(h.x), math.floor(h.y)
    val mw, mh = fl.map_size()
    val mx = math.max(mw, mh)
    val ox = (z * (hx - hy + mx)) - (m.pos@2 // 2)
    val oy = (z * (hx + hy)) - (m.pos@3 // 2)
    fl.mm_clear()
    hud.mini_entities(h, m, ox, oy, mw, mh)
    fl.mm_draw(ox, oy, m.pos@2, m.pos@3, m.x + m.pos@0, m.y + m.pos@1)
    val c = hud.image("images/menus/compass_iso.png")
    val cw, _ = fl.size(c)
    fl.draw(c, m.x + m.pos@0 + m.pos@2 - cw, m.pos@1 + m.y)
    ;; WidgetButton: its row by its state (normal, pressed, hover, disabled)
    if m.button {
        val b = hud.image("images/menus/buttons/button_config.png")
        val bw, bh4 = fl.size(b)
        val bh = bh4 // 4
        val mxs, mys = fl.mouse()
        val hover = (mxs >= m.button@0) && (mys >= m.button@1) && (mxs < (m.button@0 + bw)) && (mys < (m.button@1 + bh))
        val row = ifs {
            h.corpse => 3
            hover => 2
            else => 0
        }
        fl.part(b, 0, row * bh, bw, bh, m.button@0, m.button@1)
    }
}

;; MenuMiniMap::fillEntities: the hero, the NPCs and the teleports of the
;; events, the enemies in combat, the allies, the corpses that block
func hud.mini_entities (h, m, ox, oy, mw, mh) {
    val hx, hy = math.floor(h.x), math.floor(h.y)
    if (hx >= 0) && (hy >= 0) && (hx < mw) && (hy < mh) {
        fl.mm_entity(hx, hy, ox, oy, m.hero)
    }
    loop _, ev in hud.events || [] {
        val tele = (ev.activate == ACTIVATE.on_trigger) || (ev.activate == ACTIVATE.on_interact)
        var inter = false
        loop _, c in ev.comps {
            if c.type == "intermap" {
                set inter = true
            }
        }
        if tele && inter && event_active(ev, h) {
            loop j in (ev.loc@0, ev.loc@0 + ev.loc@2 - 1) {
                loop k in (ev.loc@1, ev.loc@1 + ev.loc@3 - 1) {
                    if fl.dist(h.x, h.y, j, k) <= m.radius {
                        fl.mm_entity(j, k, ox, oy, m.teleport)
                    }
                }
            }
        }
    }
    ;; the events of the NPCs (NPCManager::createMapEvent), after those of
    ;; the map: at the tile of the NPC
    loop _, n in hud.npcs || [] {
        val nx, ny = math.floor(n.x), math.floor(n.y)
        if fl.dist(h.x, h.y, nx, ny) <= m.radius {
            fl.mm_entity(nx, ny, ox, oy, m.npc)
        }
    }
    loop _, t in hud.ens || [] {
        val e = t.pub
        if e.hp > 0 {
            if e.hero_ally {
                if fl.dist(h.x, h.y, e.x, e.y) <= m.radius {
                    fl.mm_entity(math.floor(e.x), math.floor(e.y), ox, oy, m.ally)
                }
            } else {
                if e.in_combat && (fl.dist(h.x, h.y, e.x, e.y) <= m.radius) {
                    fl.mm_entity(math.floor(e.x), math.floor(e.y), ox, oy, m.enemy)
                }
            }
        } else {
            if e.corpse_has_collision && (fl.dist(h.x, h.y, e.x, e.y) <= m.radius) {
                fl.mm_entity(math.floor(e.x), math.floor(e.y), ox, oy, m.obst)
            }
        }
    }
}

;; MenuActiveEffects::render: each icon, and the part of disabled.png
;; below its overlay at the top of the icon
func hud.draw_effects () {
    loop _, f in hud.effects {
        hud.draw_icon(f.icon, f.x, f.y)
        val oh = hud.icon - f.oy
        if oh > 0 {
            fl.part(hud.image("images/menus/disabled.png"), 0, f.oy, hud.icon, oh, f.x, f.y)
        }
    }
}

;; MenuEnemy::render: the background, the fill of its life, its name and
;; level, and its life (or Dead, or Destroyed)
func hud.draw_enemy () {
    val en = hud.enemy
    val m = hud.emenu
    if !en {
        return nil
    }
    val dx, dy = m.x + m.pos@0, m.y + m.pos@1
    val len = if en.hp_max == 0 {
        0
    } else {
        val n = math.floor(fl.f32(fl.f32(en.hp * m.fill@0) / en.hp_max))
        if (n == 0) && (en.hp > 0) => 1 => n
    }
    if m.bg {
        fl.part(hud.image(m.bg), 0, 0, m.pos@2, m.pos@3, dx, dy)
    }
    val fx, fy = dx + m.off@0, dy + m.off@1
    if m.gfx && (len > 0) {
        fl.part(hud.image(m.gfx), 0, 0, len, m.fill@1, fx, fy)
    }
    val color = font.color("menu_normal")
    val t = m.text
    val name = en.name ++ " level " ++ en.level
    if t {
        font.label(t.style, name, m.x + t.x, m.y + t.y, t.justify, t.valign, color)
    } else {
        font.label("font_regular", name, dx + (m.pos@2 // 2), dy, font.CENTER, font.BOTTOM, color)
    }
    val life = ifs {
        en.hp > 0 => string.format("%.0f", en.hp) ++ "/" ++ string.format("%.0f", en.hp_max)
        en.lifeform => "Dead"
        else => "Destroyed"
    }
    ;; label_stats keeps the color of a WidgetLabel: widget_normal
    val wc = font.color("widget_normal")
    if m.gfx {
        font.label("font_regular", life, fx + (m.fill@0 // 2), fy + (m.fill@1 // 2), font.CENTER, font.CENTER, wc)
    } else {
        font.label("font_regular", life, dx + (m.pos@2 // 2), dy + (m.pos@3 // 2), font.CENTER, font.CENTER, wc)
    }
}

func hud.draw (h) {
    if os.getenv("FLARE_NOHUD") {
        return nil
    }
    hud.draw_mini(h)
    hud.region_title(hud.map_title)
    loop _, b in hud.stats {
        hud.draw_stat(b)
    }
    hud.draw_effects()
    hud.draw_log()
    hud.draw_bar()
    hud.draw_enemy()
    hud.draw_region()
}
