;; The game screen: GameStatePlay of the original. Its task `Play` runs the
;; logic frames in the order of `GameStatePlay::logic`, and prints the
;; trace of the patched original (`doc/fidelity.md`).
;;
;; The frame, in order:
;;      the hero                    pc->logic()
;;      a hidden draw               EntityManager::handleSpawn: Map_Enemy()
;;      the map, when it changes    checkTeleport()
;;      the tiles, the camera       mapr->logic()
;;      the trace                   benchTrace()
;;
;; What lives for one map is its context `cx` (play_cx), pinned by the task
;; `MapRun`: the enemies, the hazards, the loot, the events, and what they
;; request in a frame. The module keeps nothing of a map.

pin play = []

;; The context of a map, owned by the block of its MapRun: given to the
;; functions of the modules as an argument, and to the enemies at spawn
func play_cx (hero) {
    [
        hero = hero,        ;; the hero (outer: it lives across maps)
        ens = [],           ;; the enemies in order, as EntityManager
        hazards = [],       ;; the hazards in order of creation
        new = [],           ;; hazards made in this frame (PowerManager::hazards)
        last_enemy = nil,   ;; the enemy of the last hit (HazardManager::last_enemy)
        ground = [],        ;; the stacks of loot on the map
        dropping = [],      ;; the enemies that died in this frame (their loot)
        events = [],        ;; the events of the map
        seen = nil,         ;; what the trace saw in the last frame: the hero
        seen_es = [],       ;; and the enemies, by id
        next_id = 1,        ;; the next id of the trace in this map
        ;; what events and entities request in a frame
        teleport = nil, spawns = [], powers = [], delayed = [],
        skip_delay = false, cleared = false,
    ]
}

func play.f (x) {
    string.format("%.9g", x)
}

;; the trace of the end of a frame, as benchTrace of the patch
func play.trace (cx, h) {
    if fl.tracing() {
        val s = cx.seen
        ifs {
            s == nil => {
                fl.trace("spawn 0 " ++ h.name ++ " " ++ h.state ++ " " ++ play.f(h.x) ++ " " ++ play.f(h.y) ++ " " ++ play.f(h.hp))
            }
            else => {
                if s.state != h.state {
                    fl.trace("state 0 " ++ h.state ++ " " ++ play.f(h.x) ++ " " ++ play.f(h.y))
                }
                if h.hp < s.hp {
                    fl.trace("hit 0 " ++ play.f(h.hp))
                }
            }
        }
        set cx.seen = [state = h.state, hp = h.hp]
        ;; the enemies, in order, as the entities of EntityManager
        loop i, e in cx.ens {
            val p = e.pub
            val id = play_id(cx, p)
            val s2 = cx.seen_es@id
            if s2 == nil {
                fl.trace("spawn " ++ id ++ " " ++ p.name ++ " " ++ p.state ++ " " ++ play.f(p.x) ++ " " ++ play.f(p.y) ++ " " ++ play.f(p.hp))
            } else {
                if s2.state != p.state {
                    fl.trace("state " ++ id ++ " " ++ p.state ++ " " ++ play.f(p.x) ++ " " ++ play.f(p.y))
                }
                if p.hp < s2.hp {
                    fl.trace("hit " ++ id ++ " " ++ play.f(p.hp))
                }
            }
            set cx.seen_es@id = [state = p.state, hp = p.hp]
            if os.getenv("FLARE_DUMPE") && (id == parse.int(os.getenv("FLARE_DUMPE"))) {
                fl.trace(string.format("ent %d %.9g %.9g %d %.9g %d", id, p.x, p.y, p.state, p.hp, p.dir))
            }
        }
        if os.getenv("FLARE_DUMP") {
            fl.trace("hero " ++ play.f(h.x) ++ " " ++ play.f(h.y) ++ " " ++ h.state ++ " " ++ play.f(h.hp) ++ " " ++ h.dir)
        }
    }
    if os.getenv("FLARE_RNG") {
        val n = fl.rand_calls()
        if n > 0 {
            fl.trace("rng " ++ n)
        }
    }
}

;; the screen rectangle of an enemy at the camera (Entity::getRenderBounds)
func play.bounds (e) {
    val cx, cy = fl.cam()
    val sx, sy = fl.map2scr(e.x, e.y, cx, cy)
    val g = anim.gfx(e.cur.a, e.cur.sub, e.dir)
    if g => [sx - g@5, sy - g@6, g@3, g@4] => [0, 0, 0, 0]
}

;; GameStatePlay::checkEnemyFocus, with the mouse: the enemy of the last
;; hit of a hazard, or the alive enemy under the mouse nearest to its center
func play.focus (cx, h) {
    var enemy = nil
    if cx.last_enemy {
        set enemy = cx.last_enemy
        set cx.last_enemy = nil
    } else {
        val mx, my = fl.mouse()
        var best = nil
        loop _, t in cx.ens {
            val e = t.pub
            if (e.state != STATE.DEAD) && (e.state != STATE.CRITDEAD) {
                pin r = play.bounds(e)
                if (mx >= r@0) && (my >= r@1) && (mx < (r@0 + r@2)) && (my < (r@1 + r@3)) {
                    val d = fl.dist(mx, my, fl.f32(r@0 + (r@2 / 2)), fl.f32(r@1 + (r@3 / 2)))
                    if (best == nil) || (d < best) {
                        set best = d
                        set enemy = e
                    }
                }
            }
        }
    }
    ;; its position (the hero is outer to the enemies of a map, and nothing
    ;; moves them before the hero aims in this frame)
    set h.cursor_enemy = if enemy => [enemy.x, enemy.y] => nil
}

;; MenuActionBar::checkAction, for the main buttons of the mouse: the power
;; of the slot, aimed at the mouse (aim_assist of misc.txt: 96)
func play.actions (h) {
    loop _, i in [10, 11] {
        val k = if i == 10 => Input.MAIN1 => Input.MAIN2
        if fl.pressed(k) {
            val id = hero.actionbar@i || 0
            val pw = power.get(id)
            ;; the slot is disabled while the power is cast
            val enabled = (h.casting@id == nil) || timer_end(h.casting@id)
            if pw && enabled && (pw.requires_mp <= h.mp) {
                val mx, my = fl.mouse()
                val tx, ty = fl.scr2map(mx, if pw.aim_assist => (my + 96) => my)
                if timer_end(h.cooldown) && (h.state != STATE.POWER) && (h.state != STATE.HIT) {
                    set h.actions@+ = [power = id, target = [tx, ty]]
                }
            }
        }
    }
}

;; the hidden draws of a map loaded (EntityManager::handleNewMap): a
;; Map_Enemy, and getRandomNeighbor of the tiles around the hero
func play.new_map_draws (x, y, no_enemy) {
    if !no_enemy {
        fl.rand()
    }
    var n = 0
    loop i in (-1, 1) {
        loop j in (-1, 1) {
            if (i != 0) || (j != 0) {
                if fl.col_valid(math.floor(x) + i + 0.5, math.floor(y) + j + 0.5, MOVE.NORMAL, COLLIDE.ALL) {
                    set n += 1
                }
            }
        }
    }
    if n > 0 {
        fl.rand()
    }
}

;; A new game in a map, at a position (or at the hero of the map).
;; the id of an entity or a StatBlock of an event in the trace: the next one
;; when it is seen for the first time in a map, as bench::id of the patch
func play_id (cx, p) {
    if p.id == nil {
        set p.id = cx.next_id
        set cx.next_id = cx.next_id + 1
    }
    p.id
}

;; EntityManager::handleSpawn: the entities requested in this frame, in
;; state SPAWN (with the draw of the enemy of their category)
func play_spawns (cx, es) {
    loop _, sp in cx.spawns {
        fl.col_unblock(sp.x, sp.y)
        val el = enemy_random(sp.type, 0, 0)
        if el {
            val t = spawn @es Enemy(enemy.stats(el.type),
                [type = el.type, x = sp.x, y = sp.y, dir = sp.dir, wander = 0, waypoints = [], state = "spawn"], cx)
            set cx.ens@+ = t
            ;; the summons die with their summoner
            if sp.summoner {
                set sp.summoner.summons = sp.summoner.summons || []
                set sp.summoner.summons@+ = t.pub
            }
            fl.col_block(sp.x, sp.y, false)
        }
    }
    set cx.spawns = []
}

;; A map, from its load (in the checkTeleport of a frame) to the frame in
;; which a teleport to another map is requested. It ends with that request.
task MapRun (path, pos, h) {
    val hp = h.pub
    fl.trace("map " ++ path)
    pin m = map.load(path)
    val p = pos || m.hero
    set hp.x, hp.y = fl.f32(p@0), fl.f32(p@1)
    set hp.camera_lock = true
    fl.cam_warp(hp.x, hp.y)
    pin cx = play_cx(hp)
    ;; Map::load: the events, with a StatBlock for those with a power
    set cx.events = event.load(m)
    ;; MapRenderer::load: the groups of enemies
    pin placed = enemy.place(enemy.groups(m))
    ;; the events on load
    event.on_load(cx.events, cx)
    ;; EntityManager::handleNewMap: its Map_Enemy, the enemies, the neighbor
    fl.rand()
    pin es = tasks()
    loop _, me in placed {
        val t = spawn @es Enemy(enemy.stats(me.type), me, cx)
        set cx.ens@+ = t
        fl.col_block(me.x, me.y, false)
    }
    play.new_map_draws(p@0, p@1, true)
    fl.col_block(hp.x, hp.y, false)

    ;; the rest of the frame of the load
    event.logic(cx.events, cx)
    fl.tset_logic()
    fl.cam_logic()
    play.trace(cx, hp)

    ;; EntityManager::addRenders and HazardManager::addRenders: the
    ;; enemies (a corpse below the objects, until its timeout), the hazards
    ;; (on the floor below the objects); drawn by Play, after the hero
    spawn {
        loop on :draw {
            loop _, t in cx.ens {
                val e = t.pub
                val gone = e.corpse && timer_end(e.corpse_timer)
                val g = anim.gfx(e.cur.a, e.cur.sub, e.dir)
                if g && !gone && !fl.col_outside(e.x, e.y) {
                    fl.ren(e.corpse, g@0, g@1, g@2, g@3, g@4, g@5, g@6, e.x, e.y, 1, false)
                }
            }
            ;; LootManager::addRenders: below the objects when landed
            loop _, lg in cx.ground {
                if lg.cur && !fl.col_outside(lg.x, lg.y) {
                    val g = anim.gfx(lg.cur.a, lg.cur.sub, 0)
                    if g {
                        fl.ren(anim.is_last(lg.cur), g@0, g@1, g@2, g@3, g@4, g@5, g@6, lg.x, lg.y, 0, false)
                    }
                }
            }
            loop _, hz in cx.hazards {
                if (hz.delay == 0) && hz.cur {
                    val g = anim.gfx(hz.cur.a, hz.cur.sub, hz.dir)
                    if g {
                        val fl_ = hz.power.on_floor
                        fl.ren(fl_, g@0, g@1, g@2, g@3, g@4, g@5, g@6, hz.x, hz.y, if fl_ => 0 => 2, false)
                    }
                }
            }
        }
    }

    loop on :frame {
        ;; GameStatePlay::checkLoot: currency picked up goes to the hero
        if hp.hp > 0 {
            val id, q = loot.autopickup(cx, hp)
            if id != nil {
                fl.trace(string.format("pickup %d %d", id, q))
                set hp.currency = (hp.currency || 0) + q
            }
        }
        if hp.hp > 0 {
            event.hotspots(cx.events, cx)
        }
        play.focus(cx, hp)
        play.actions(hp)
        emit @h :hero.logic
        ;; what the hero asked of the map in its frame, in order: its
        ;; powers (PowerManager::activate) and the events at its place
        ;; (MapRenderer::checkEvents); the hero lives across maps, and
        ;; cannot hold the context of one
        loop _, r in hp.requests {
            if r.power {
                power_activate(cx, r.power, hp, hp.x, hp.y, r.tx, r.ty)
            } else {
                event.check(cx.events, hp.x, hp.y, cx)
            }
        }
        set hp.requests = []
        fl.rand()                       ;; handleSpawn: Map_Enemy()
        play_spawns(cx, es)
        loop _, t in cx.ens {
            emit @t :enemy.logic [hero = hp]
        }
        hazards_logic(cx, hp)
        loot.logic(cx, hp)
        ;; checkTeleport: another map ends this one
        if cx.teleport {
            val tp = cx.teleport
            set cx.teleport = nil
            if tp.map {
                ;; a copy: the context goes with this map
                break [map = tp.map, pos = if tp.pos => [tp.pos@0, tp.pos@1] => nil]
            }
            set hp.x, hp.y = fl.f32(tp.pos@0), fl.f32(tp.pos@1)
        }
        set cx.cleared = true
        loop _, t in cx.ens {
            if t.pub.hp > 0 {
                set cx.cleared = false
            }
        }
        event.logic(cx.events, cx)
        fl.tset_logic()
        fl.cam_logic()
        play.trace(cx, hp)
    }
}

;; A new game in a map, at a position (or at the hero of the map), then the
;; maps it teleports to.
task Play (path, pos, class) {
    pin st = hero.stats(class)
    hero.load_sfx("male")
    hero.load_steps(st.sfx_step)

    ;; GameStatePlay(): the hidden draw of its handleNewMap
    fl.rand()

    ;; frame 0: the hidden draw of the frame, then the map
    await :frame
    fl.rand()
    pin h = spawn Hero(st, pos || [0, 0])

    spawn {
        ;; the next map (a variable does not own a table)
        pin st = [next = [map = path, pos = pos]]
        loop {
            set st.next = await MapRun(st.next.map, st.next.pos, h)
        }
    }

    loop on :draw {
        val hp = h.pub
        val g = anim.gfx(hp.cur.a, hp.cur.sub, hp.dir)
        if g && !os.getenv("FLARE_NOHERO") {
            fl.ren(false, g@0, g@1, g@2, g@3, g@4, g@5, g@6, hp.x, hp.y, 0, true)
        }
        fl.map_render()
        fl.ren_clear()          ;; the maps add theirs before the next draw
    }
}
