;; Loot: the tables of `loot/`, the loot of an enemy, and the drops at its
;; death, as LootManager of the original (loadLootTables, parseLoot,
;; checkEnemiesForLoot, checkLoot, checkLootComponent).
;;
;; An entry: [table = true] for the name of a table (its entries follow
;; it), or [id, chance, qmin, qmax, max_drops]; a chance of 0 is fixed.

pin loot = [
    tables = [],        ;; path -> entries
    dropping = [],      ;; the enemies that died in this frame
    drop_max = 1,       ;; of engine/loot.txt
    drop_radius = 1,
    currency = 10,      ;; currency_id of engine/misc.txt
    ground = [],        ;; the stacks on the map: [id, q, x, y, cur, on_ground]
    autopickup_currency = false,    ;; of engine/loot.txt
    currency_name = "Gold",         ;; of engine/loot.txt
    autopickup_range = 1.0,
    map = [],           ;; the loot of events, to drop in the next loot step
    unblock = [],       ;; the tiles blocked by drops of this loot step
]

;; LootManager::addLoot: a stack on the map, aligned to 1/16 of a tile,
;; merged with a stack of the same item at the same place, or with the
;; animation of its item for its quantity
func loot_add (id, q, x, y) {
    val ax = fl.f32(math.floor(fl.f32(x) / 0.0625) * 0.0625)
    val ay = fl.f32(math.floor(fl.f32(y) / 0.0625) * 0.0625)
    var i = #loot.ground
    loop {
        while i > 0
        set i -= 1
        val g = loot.ground@i
        if (g.id == id) && (g.x == ax) && (g.y == ay) {
            set g.q = g.q + q
            return nil
        }
    }
    val it = item.get(id)
    ;; built in place, owned by the module
    val g = vector.insert(loot.ground, [id = id, q = q, x = ax, y = ay, cur = nil, on_ground = true])
    if it && (#it.loot_animation > 0) {
        var la = it.loot_animation@(#it.loot_animation - 1)
        loop _, a in it.loot_animation {
            if (q >= a.low) && ((q <= a.high) || (a.high == 0)) {
                set la = a
                break
            }
        }
        set g.cur = anim.cursor(anim.get(anim.load(la.name), ""))
        set g.on_ground = false
    }
}

func loot_entry (id, chance, l, k) {
    val qmin = math.max(parse.int(l@k), 1)
    [id = id, chance = if chance == "fixed" => 0.0 => parse.float(chance),
     qmin = qmin, qmax = math.max(parse.int(l@(k+1)), qmin), max_drops = -1]
}

func loot_id (s) {
    if s == "currency" => loot.currency => parse.int(s, -1)
}

;; LootManager::parseLoot: the entries of `loot=` into a list
func loot.parse (l, list) {
    var k = 0
    loop {
        while (l@k != nil) && (l@k != "")
        val id = loot_id(l@k)
        if id == -1 {
            set list@+ = [table = true]
            loop _, e in loot.tables@(l@k) || [] {
                set list@+ = X.copy(e)
            }
            set k += 1
        } else {
            set list@+ = loot_entry(id, l@(k+1) || "", l, k+2)
            set k += 4
        }
    }
}

func loot.init () {
    loop _, s in ini.load("engine/loot.txt") || [] {
        loop _, kv in s.keys {
            match kv@0 {
                "drop_max" => { set loot.drop_max = parse.int(kv@1) }
                "drop_radius" => { set loot.drop_radius = parse.int(kv@1) }
                "autopickup_currency" => { set loot.autopickup_currency = parse.bool(kv@1) }
                "autopickup_range" => { set loot.autopickup_range = parse.float(kv@1) }
                "currency_name" => { set loot.currency_name = kv@1 }
            }
        }
    }
    loop _, s in ini.load("engine/misc.txt") || [] {
        loop _, kv in s.keys {
            if kv@0 == "currency_id" {
                set loot.currency = parse.int(kv@1)
            }
        }
    }
    loop _, path in list_dir("loot") {
        ;; built in place, owned by the module
        set loot.tables@path = []
        val list = loot.tables@path
        loop _, s in ini.load(path) || [] {
            if s.name == "loot" {
                var id = nil
                var chance = ""
                pin var q = []
                loop _, kv in s.keys {
                    match kv@0 {
                        "id" => { set id = loot_id(kv@1) }
                        "chance" => { set chance = kv@1 }
                        "quantity" => { set q = parse.list(kv@1) }
                    }
                }
                set list@+ = loot_entry(id, chance, q, 0)
            } else {
                loop _, kv in s.keys {
                    if kv@0 == "loot" {
                        loot.parse(parse.list(kv@1), list)
                    }
                }
            }
        }
    }
}

;; LootManager::checkLootComponent: a stack at a free place
func loot_drop (e, x, y, hero) {
    val sx, sy = math.floor(x), math.floor(y)
    var px, py = sx + 0.5, sy + 0.5
    if !fl.col_valid(px, py, MOVE.NORMAL, COLLIDE.ALL) {
        val nx, ny = fl.random_neighbor(sx, sy, loot.drop_radius, MOVE.NORMAL, COLLIDE.ALL)
        set px, py = nx, ny
        if !fl.col_valid(px, py, MOVE.NORMAL, COLLIDE.ALL) {
            set px, py = hero.x, hero.y
        } else {
            if (sx == math.floor(px)) && (sy == math.floor(py)) {
                set px, py = hero.x, hero.y
            }
            fl.col_block(px, py, false)
            set loot.unblock@+ = [px, py]
        }
    }
    val q = rand_between(e.qmin, e.qmax)
    ;; an item id of 0 is currency
    val id = if e.id == 0 => loot.currency => e.id
    fl.trace(string.format("loot %d %d %.9g %.9g", id, q, fl.f32(px), fl.f32(py)))
    loot_add(id, q, px, py)
}

;; LootManager::checkLoot
func loot_check (list, x, y, hero) {
    val chance = rand_between_f(0, 100)
    ;; the fixed ones drop, and leave the list
    var i = #list
    loop {
        while i > 0
        set i -= 1
        val e = list@i
        if !e.table && (e.chance == 0) {
            loot_drop(e, x, y, hero)
            vector.remove(list, i)
        }
    }
    var threshold = 100.0
    pin var possible = []
    loop _, e in list {
        if !e.table {
            if e.chance >= chance {
                if e.chance <= threshold {
                    if e.chance != threshold {
                        set possible = []
                    }
                    set threshold = e.chance
                }
                if (chance <= threshold) && (e.max_drops != 0) {
                    set possible@+ = e
                }
            }
        }
    }
    if #possible > 0 {
        val e = possible@(fl.rand() % #possible)
        loot_drop(e, x, y, hero)
        if e.max_drops > 0 {
            set e.max_drops = e.max_drops - 1
        }
    }
}

;; Loot::isFlying
func loot_flying (g) {
    g.cur && !anim.is_last(g.cur) && (g.cur.times == 0)
}

;; LootManager::checkAutoPickup, with auto_loot on (the default): the last
;; stack of currency near the hero, landed, leaves the ground (the alpha
;; demo has no item type with auto_pickup); its item and quantity, or nil
func loot.autopickup (hero) {
    var i = #loot.ground
    loop {
        while i > 0
        set i -= 1
        val g = loot.ground@i
        if (fl.dist(hero.x, hero.y, g.x, g.y) < loot.autopickup_range) && !loot_flying(g) {
            if (g.id == loot.currency) && loot.autopickup_currency {
                val id, q = g.id, g.q
                vector.remove(loot.ground, i)
                return id, q
            }
        }
    }
    nil
}

;; LootManager::checkPickup, with the mouse: the last stack landed whose
;; tile is under the mouse, near the hero (interact_range of 3), with a
;; press of MAIN1; its item and quantity, or nil. Not ported: a click on
;; the tooltip of a stack (the tooltips are of the HUD), mouse-move, and
;; the pickup of the nearest stack with ACCEPT.
func loot.pickup (hero) {
    val mx, my = fl.mouse()
    val cx, cy = fl.cam()
    val tw, th = fl.tile()
    var m = nil
    var i = #loot.ground
    loop {
        while i > 0
        set i -= 1
        val g = loot.ground@i
        if (m == nil) && !loot_flying(g) {
            val sx, sy = fl.map2scr(g.x, g.y, cx, cy)
            val rx, ry = sx - (tw // 2), sy - (th // 2)
            if (mx >= rx) && (my >= ry) && (mx < (rx + tw)) && (my < (ry + th)) {
                set m = i
            }
        }
    }
    if m != nil {
        val g = loot.ground@m
        if fl.dist(hero.x, hero.y, g.x, g.y) < 3 {
            cursor.set("interact")
        }
        if (fl.dist(hero.x, hero.y, g.x, g.y) < 3) && fl.pressed(Input.MAIN1) {
            fl.lock(Input.MAIN1, true)
            val id, q = g.id, g.q
            vector.remove(loot.ground, m)
            return id, q
        }
    }
    nil
}

;; LootManager::addEnemyLoot
func loot_dropping (e) {
    set :out loot.dropping@(#loot.dropping) = e
}

;; LootManager::checkEnemiesForLoot, once per frame after the hazards
func loot.logic (hero) {
    ;; the flying stacks animate, until they land
    loop _, g in loot.ground {
        if g.cur {
            anim.advance(g.cur)
            if !g.on_ground && (if g.cur.a.default_active => anim.is_second_last(g.cur) => anim.is_active(g.cur)) {
                set g.on_ground = true
            }
        }
    }
    loop _, en in loot.dropping {
        if #en.loot > 0 {
            val n = if en.loot_count@1 != 0 => rand_between(en.loot_count@0, en.loot_count@1) => rand_between(1, loot.drop_max)
            loop in n {
                loot_check(en.loot, en.x, en.y, hero)
            }
            set en.loot = []
        }
    }
    set loot.dropping = []
    ;; LootManager::checkMapForLoot
    loop _, m in loot.map {
        val n = if m.count@1 != 0 => rand_between(m.count@0, m.count@1) => rand_between(1, loot.drop_max)
        loop in n {
            loot_check(m.entries, m.x, m.y, hero)
        }
    }
    set loot.map = []
    ;; the tiles blocked by the drops are free again
    loop _, t in loot.unblock {
        fl.col_unblock(t@0, t@1)
    }
    set loot.unblock = []
}
